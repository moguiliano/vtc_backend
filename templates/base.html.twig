<!DOCTYPE html>
<html lang="fr">
  <head>
    <!-- Consentement cookies + Google Tag Manager (chargé uniquement après « Tout accepter ») -->
    <script>
    (function (w, d) {
      var KEY = 'zc_consent', MAX_AGE = 1000 * 60 * 60 * 24 * 182; // choix conservé 6 mois
      w.dataLayer = w.dataLayer || [];
      function gtag() { w.dataLayer.push(arguments); }
      w.gtag = w.gtag || gtag;
      // Consent Mode v2 : tout est refusé par défaut
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted'
      });
      var gtmLoaded = false;
      function loadGtm() {
        if (gtmLoaded) { return; }
        gtmLoaded = true;
        w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var j = d.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-WXJ6V2W4';
        d.head.appendChild(j);
      }
      function current() {
        try {
          var raw = JSON.parse(w.localStorage.getItem(KEY) || 'null');
          if (raw && raw.v && (Date.now() - raw.t) < MAX_AGE) { return raw.v; }
        } catch (e) {}
        return null;
      }
      function apply(value) {
        if (value !== 'granted') { return; }
        gtag('consent', 'update', {
          ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted'
        });
        loadGtm();
      }
      w.zcConsent = {
        current: current,
        save: function (value) {
          try { w.localStorage.setItem(KEY, JSON.stringify({ v: value, t: Date.now() })); } catch (e) {}
          if (value !== 'granted' && gtmLoaded) { w.location.reload(); return; } // retrait du consentement
          apply(value);
        }
      };
      apply(current());
    })(window, document);
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Permissions-Policy" content="geolocation=*">

    {# ── SEO ─────────────────────────────────────────────────────────── #}
    {% block meta %}
    <meta name="description" content="Taxi & VTC à Marseille en 5 à 10 min. Prix VTC annoncé avant le départ, taxis partenaires agréés. Gare, aéroport, calanques. 06 74 03 96 94." />
    <meta name="robots" content="index, follow" />
    {% endblock %}

    {% block canonical %}
    <link rel="canonical" href="https://dzencar.fr/" />
    {% endblock %}

    {# ── Open Graph ───────────────────────────────────────────────────── #}
    {% block opengraph %}
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="ZenCAR Taxi & VTC Marseille" />
    <meta property="og:title"       content="{% block og_title %}Taxi Marseille — ZenCAR Taxi & VTC{% endblock %}" />
    <meta property="og:description" content="{% block og_description %}Taxi & VTC à Marseille en 5 à 10 min. Prix VTC annoncé avant le départ, taxis partenaires agréés. Gare, aéroport, calanques.{% endblock %}" />
    <meta property="og:url"         content="{% block og_url %}https://dzencar.fr/{% endblock %}" />
    {% endblock %}

    {# ── JSON-LD (schemas structurés) ────────────────────────────────── #}
    {% block jsonld %}{% endblock %}

    {# ── Assets ───────────────────────────────────────────────────────── #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/css/intlTelInput.min.css" />
    <link href="{{ asset('build/app.css') }}" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/zencar.css') }}?v=3">
    <link rel="stylesheet" href="{{ asset('css/reservationStyles.css') }}?v=4">

    <title>{% block title %}Taxi & VTC Marseille — ZenCAR{% endblock %}</title>

    {% block stylesheets %}{% endblock %}
  </head>

  <body class="bg-light">
    {% include 'partials/_navbar.html.twig' %}

    <!-- ✅ Boutons Appel / WhatsApp visibles sur toutes tailles d'écran -->
   
    <main>
      {% block body %}{% endblock %}
    </main>

    {% include 'partials/_footer.html.twig' %}
    {% include 'partials/_cookie_consent.html.twig' %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
