{% extends 'espace/base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<div class="zen-card zen-narrow">
    <h1 class="text-center mb-4">Connexion à mon espace</h1>
    {% if error %}
        <div class="alert alert-danger py-2">E-mail ou mot de passe incorrect.</div>
    {% endif %}
    <form method="post" action="{{ path('espace_connexion') }}">
        <div class="mb-3">
            <label class="form-label" for="username">E-mail</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control" autocomplete="email" required autofocus>
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" class="form-control" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn btn-zen w-100 mt-2" type="submit">Se connecter</button>
        <p class="text-center mt-3 mb-0 small"><a href="{{ path('espace_mot_de_passe_oublie') }}">Mot de passe oublié ?</a></p>
    </form>
    <p class="text-center mt-4 mb-0 muted small">Pas encore d'espace ? <a href="{{ path('espace_inscription') }}">Créer mon espace</a></p>
</div>
{% endblock %}
