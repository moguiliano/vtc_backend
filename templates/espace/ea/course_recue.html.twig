{% extends '@EasyAdmin/page/content.html.twig' %}
{# Fiche d'une course confiée (D-104 informations, D-105 montants, D-102 / D-106 statut) #}
{% set prix = r.prix|default(0) %}
{% set commission = partage.commission(r) %}
{% block page_title %}Course reçue n°{{ r.id }}{% endblock %}
{% block content_title %}
    Course reçue n°{{ r.id }}
    {% if r.statutChauffeur %}<span class="badge bg-{{ r.statutChauffeur.badge }} ms-2" style="font-size:.75rem;vertical-align:middle;">{{ r.statutChauffeur.label }}</span>
    {% else %}<span class="badge bg-warning text-dark ms-2" style="font-size:.75rem;vertical-align:middle;">À répondre</span>{% endif %}
{% endblock %}
{% block page_actions %}
    <a class="btn btn-secondary" href="{{ path('espace_courses_recues') }}"><i class="fa fa-arrow-left"></i> Courses reçues</a>
{% endblock %}
{% block main %}
{% if r.statutChauffeur and r.statutChauffeur.value == 'retire' %}
    <div class="alert alert-secondary">Vous vous êtes retiré de cette course. Elle disparaîtra de votre espace quand ZenCAR l'aura confiée à un autre chauffeur.</div>
{% endif %}
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Trajet</h5>
            <table class="table table-sm mb-0">
                <tr><th style="width:35%">Date & heure</th><td>{{ r.dateHeureDepart ? r.dateHeureDepart|date('d/m/Y à H:i') : '—' }}</td></tr>
                <tr><th>Départ</th><td>{{ r.depart }}</td></tr>
                {% if r.stopLieu %}<tr><th>Arrêt</th><td>{{ r.stopLieu }}</td></tr>{% endif %}
                <tr><th>Arrivée</th><td>{{ r.arrivee }}</td></tr>
                <tr><th>Véhicule</th><td>{{ r.typeVehicule }}</td></tr>
                {% if r.distance %}<tr><th>Distance</th><td>{{ r.distance|number_format(1, ',', ' ') }} km{% if r.duree %} · {{ r.duree|round }} min{% endif %}</td></tr>{% endif %}
                {% if r.siegeBebe %}<tr><th>Siège bébé</th><td>Oui</td></tr>{% endif %}
                {% if r.informationsComplementaires %}<tr><th>Informations</th><td>{{ r.informationsComplementaires|nl2br }}</td></tr>{% endif %}
            </table>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-3"><div class="card-body">
            <h5 class="card-title">Client</h5>
            {% set tel = partage.telephoneClient(r) %}
            <p class="mb-1"><strong>{{ partage.prenomClient(r) ?: '—' }}</strong></p>
            {% if tel %}<p class="mb-0"><a href="tel:{{ tel }}"><i class="fa fa-phone"></i> {{ tel }}</a></p>{% endif %}
        </div></div>
        <div class="card"><div class="card-body">
            <h5 class="card-title">Montants <small class="text-muted">(fixés par {{ r.entreprise ? r.entreprise.nom : 'ZenCAR' }})</small></h5>
            <table class="table table-sm mb-0">
                <tr><th>À encaisser</th><td>{{ prix|number_format(2, ',', ' ') }} € <span class="text-muted">({{ r.modeReglement == 'especes' ? 'espèces' : 'carte bancaire' }})</span></td></tr>
                <tr><th>Commission {{ r.entreprise ? r.entreprise.nom : 'ZenCAR' }}</th><td>{{ commission|number_format(2, ',', ' ') }} €</td></tr>
                <tr><th>Votre net</th><td><strong>{{ (prix - commission)|number_format(2, ',', ' ') }} €</strong></td></tr>
            </table>
        </div></div>
    </div>
</div>

{% if boutons is not empty %}
<div class="card mt-3"><div class="card-body d-flex flex-wrap gap-2 align-items-center">
    <strong class="me-2">Votre réponse :</strong>
    {% for b in boutons %}
        <form method="post" action="{{ path('espace_course_recue_statut', {id: r.id}) }}" class="d-inline"
              {% if b.value == 'retire' %}onsubmit="return confirm('Vous retirer de cette course ? ZenCAR sera prévenu pour la confier à un autre chauffeur.');"{% endif %}>
            <input type="hidden" name="_token" value="{{ csrf_token('course-recue-' ~ r.id) }}">
            <input type="hidden" name="statut" value="{{ b.value }}">
            <button class="btn {{ b.value == 'retire' ? 'btn-outline-danger' : 'btn-primary' }}" type="submit">{{ b.bouton }}</button>
        </form>
    {% endfor %}
</div></div>
{% endif %}
{% endblock %}
