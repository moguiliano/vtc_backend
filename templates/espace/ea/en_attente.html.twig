{% extends '@EasyAdmin/page/content.html.twig' %}
{% block page_title %}En attente de validation{% endblock %}
{% block content_title %}Merci, {{ entreprise.nom }} ! <span class="badge bg-warning text-dark ms-2" style="font-size:.75rem;vertical-align:middle;">{{ entreprise.etat.label }}</span>{% endblock %}
{% block main %}
<div class="card"><div class="card-body">
    <p>Vos informations sont bien reçues. ZenCAR les vérifie ; votre espace s'ouvrira dès la validation, et votre <strong>mois d'essai gratuit</strong> commencera ce jour-là.</p>
    <p class="text-muted small">Une erreur ? Vous pouvez encore <a href="{{ path('espace_ma_societe') }}">corriger vos informations</a>.</p>
    <h6 class="mt-3">Ce que vous avez envoyé</h6>
    {% include 'espace/ea/_fiche_societe.html.twig' %}
</div></div>
{% endblock %}
