{% extends '@EasyAdmin/page/content.html.twig' %}
{# « Mes prix », simple d'abord (D-092) : une ligne par véhicule, les 4 chiffres derrière « Personnaliser ». #}
{% block page_title %}Mes prix{% endblock %}
{% block content_title %}Mes prix{% endblock %}
{% block main %}
<style>
  .veh-ligne { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem 1rem; }
  .veh-ligne .nom { font-weight:600; min-width:150px; }
  .veh.off .veh-ligne .nom, .veh.off .resume { opacity:.55; }
  .resume { color: var(--text-muted, #6c757d); }
  .perso summary { cursor:pointer; color: var(--link-color, #2563eb); list-style:none; font-size:.9rem; }
  .perso summary::-webkit-details-marker { display:none; }
  .perso[open] summary { margin-bottom:.6rem; }
  .perso input { width:80px; display:inline-block; text-align:right; padding:2px 6px; }
  .perso .ligne { margin:.35rem 0; }
</style>

<p class="text-muted">Cochez les véhicules que vous proposez. Vos prix sont ceux de ZenCAR et se mettent à jour tout seuls.
    Besoin d'autres prix ? Cliquez sur « Personnaliser ».</p>
{% if not modifiable %}<div class="alert alert-info">Votre espace est en lecture seule : vos prix sont visibles mais ne peuvent pas être modifiés.</div>{% endif %}
{% for e in erreurs %}<div class="alert alert-danger">{{ e }}</div>{% endfor %}

<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('mes-prix') }}">
    <div class="card mb-3"><ul class="list-group list-group-flush">
    {% for g in grilles %}
        {% set s = saisis ? (saisis[g.id] ?? {}) : {} %}
        {% set v = {
            seuil: s.seuil ?? g.thresholdKm, pec: s.pec ?? g.basePriceUnderThreshold,
            km_sous: s.km_sous ?? g.pricePerKmUnderThreshold, km_sur: s.km_sur ?? g.pricePerKmOverThreshold } %}
        <li class="list-group-item veh {{ g.actif ? '' : 'off' }}" data-veh>
            <div class="veh-ligne">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="actif-{{ g.id }}" name="actif[{{ g.id }}]" value="1"
                           {{ g.actif ? 'checked' : '' }} {{ modifiable ? '' : 'disabled' }} data-actif>
                    <label class="form-check-label nom" for="actif-{{ g.id }}">{{ g.categorie.label }}</label>
                </div>
                {% if g.suitZencar %}
                    <span class="badge bg-success-subtle text-success-emphasis">Prix ZenCAR</span>
                {% else %}
                    <span class="badge bg-warning-subtle text-warning-emphasis">Mes prix</span>
                {% endif %}
                <span class="resume" data-resume>à partir de {{ g.basePriceUnderThreshold|number_format(2, ',', ' ') }} €</span>
            </div>
            <details class="perso mt-1" {{ s is not empty ? 'open' : '' }}>
                <summary><i class="fa fa-sliders"></i> Personnaliser</summary>
                <div class="ligne">Jusqu'à <input class="form-control form-control-sm" name="prix[{{ g.id }}][seuil]" value="{{ v.seuil }}" inputmode="decimal" data-seuil {{ modifiable ? '' : 'disabled' }}> km :
                    <input class="form-control form-control-sm" name="prix[{{ g.id }}][pec]" value="{{ v.pec }}" inputmode="decimal" data-pec {{ modifiable ? '' : 'disabled' }}> € de prise en charge
                    + <input class="form-control form-control-sm" name="prix[{{ g.id }}][km_sous]" value="{{ v.km_sous }}" inputmode="decimal" data-kmsous {{ modifiable ? '' : 'disabled' }}> € / km</div>
                <div class="ligne">Au-delà : <strong data-auseuil></strong> <span class="text-muted small">(prix au seuil, calculé)</span>
                    + <input class="form-control form-control-sm" name="prix[{{ g.id }}][km_sur]" value="{{ v.km_sur }}" inputmode="decimal" data-kmsur {{ modifiable ? '' : 'disabled' }}> € / km</div>
                <div class="small text-muted" data-exemple></div>
                {% if not g.suitZencar and modifiable %}
                    <button type="submit" name="raccrocher" value="{{ g.id }}" class="btn btn-link btn-sm px-0"><i class="fa fa-undo"></i> Revenir aux prix ZenCAR</button>
                {% endif %}
            </details>
        </li>
    {% endfor %}
        <li class="list-group-item">
            <div class="form-check form-switch m-0 d-inline-block">
                <input class="form-check-input" type="checkbox" role="switch" id="nuit-active" name="nuit_active" value="1"
                       {{ entreprise.nuitActive ? 'checked' : '' }} {{ modifiable ? '' : 'disabled' }}>
                <label class="form-check-label" for="nuit-active">Majorer mes courses de nuit (23 h – 7 h) de</label>
            </div>
            <input class="form-control form-control-sm d-inline-block" style="width:70px;text-align:right;" name="nuit_pourcent" value="{{ entreprise.nuitPourcent }}" inputmode="decimal" {{ modifiable ? '' : 'disabled' }}> %
        </li>
    </ul></div>
    {% if modifiable %}<button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Enregistrer</button>{% endif %}
</form>

<script>
(function () {
  const n = (el) => parseFloat(String(el.value).replace(',', '.').replace(/\s/g, '')) || 0;
  const eur = (x) => x.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  document.querySelectorAll('[data-veh]').forEach((bloc) => {
    const seuil = bloc.querySelector('[data-seuil]'), pec = bloc.querySelector('[data-pec]'),
          ks = bloc.querySelector('[data-kmsous]'), kr = bloc.querySelector('[data-kmsur]');
    const maj = () => {
      const S = n(seuil), P = n(pec), A = n(ks), B = n(kr), auSeuil = P + S * A;
      const prix = (d) => d <= S ? P + d * A : auSeuil + (d - S) * B;
      const d1 = Math.max(1, Math.round(S * 0.8)), d2 = Math.round(S + 15);
      bloc.querySelector('[data-auseuil]').textContent = eur(auSeuil);
      bloc.querySelector('[data-resume]').textContent = `à partir de ${eur(P)} · ${d2} km ≈ ${eur(prix(d2))}`;
      bloc.querySelector('[data-exemple]').textContent = `Exemple de jour : ${d1} km = ${eur(prix(d1))} · ${d2} km = ${eur(prix(d2))}`;
    };
    [seuil, pec, ks, kr].forEach((el) => el.addEventListener('input', maj));
    bloc.querySelector('[data-actif]')?.addEventListener('change', (e) => bloc.classList.toggle('off', !e.target.checked));
    maj();
  });
})();
</script>
{% endblock %}
