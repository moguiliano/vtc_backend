{% extends 'espace/base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
<div class="zen-card zen-narrow">
    <h1 class="text-center mb-3">Mot de passe oublié</h1>
    {% if envoye %}
        <div class="alert alert-success py-2">Si un espace existe avec cet e-mail, un message vient d'être envoyé avec un lien pour choisir un nouveau mot de passe (valable 1 heure).</div>
        <p class="muted small mb-0">Pas reçu ? Regardez dans les indésirables, ou appelez ZenCAR au <a href="tel:+33674039694">06 74 03 96 94</a>.</p>
    {% else %}
        {% if erreur %}<div class="alert alert-danger py-2">{{ erreur }}</div>{% endif %}
        <p class="muted small">Indiquez l'e-mail de votre espace : nous vous envoyons un lien pour choisir un nouveau mot de passe.</p>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('mot-de-passe-oublie') }}">
            <div class="mb-3">
                <label class="form-label" for="email">E-mail</label>
                <input type="email" id="email" name="email" class="form-control" autocomplete="email" required autofocus>
            </div>
            <button class="btn btn-zen w-100" type="submit">Recevoir le lien</button>
        </form>
        <p class="muted small mt-3 mb-0">Besoin d'aide ? Appelez ZenCAR au <a href="tel:+33674039694">06 74 03 96 94</a>.</p>
    {% endif %}
    <p class="text-center mt-4 mb-0 small"><a href="{{ path('espace_connexion') }}">Retour à la connexion</a></p>
</div>
{% endblock %}
