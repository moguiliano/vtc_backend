<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Espace pro{% endblock %} — ZenCAR</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { --zen-orange: #ff5630; }
        body { margin: 0; min-height: 100vh; background: linear-gradient(135deg, #0d1117 0%, #1a2332 100%);
               color: #e6e6e6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
        .espace-bar { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;
                      padding: .9rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,.08); background: rgba(0,0,0,.25); }
        .espace-bar .brand { font-weight: 800; color: var(--zen-orange); font-size: 1.3rem; text-decoration:none; }
        .espace-bar .brand small { color: rgba(255,255,255,.45); font-weight: 500; font-size: .75rem; letter-spacing: 2px; text-transform: uppercase; margin-left: .4rem; }
        .espace-bar a.nav-l { color: rgba(255,255,255,.75); text-decoration: none; margin-left: 1rem; font-size: .9rem; }
        .espace-bar a.nav-l:hover { color: var(--zen-orange); }
        .zen-card { background: #1a1d27; border: 1px solid rgba(255,255,255,.08); border-radius: 18px;
                    padding: 2rem 1.6rem; box-shadow: 0 24px 64px rgba(0,0,0,.4); }
        .zen-narrow { max-width: 460px; margin: 3rem auto; }
        .zen-wide { max-width: 860px; margin: 2rem auto; }
        h1, h2 { color: #fff; }
        h1 { font-size: 1.4rem; font-weight: 700; }
        .form-label, label { color: rgba(255,255,255,.75); font-size: .88rem; }
        .form-control { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 10px; color: #fff; }
        .form-control:focus { background: rgba(255,255,255,.09); border-color: var(--zen-orange); box-shadow: 0 0 0 3px rgba(255,86,48,.15); color: #fff; }
        .form-text, .help-text { color: rgba(255,255,255,.45) !important; }
        .form-check-input:checked { background-color: var(--zen-orange); border-color: var(--zen-orange); }
        .btn-zen { background: var(--zen-orange); color: #fff; border: none; border-radius: 50px; padding: 11px 26px; font-weight: 700; }
        .btn-zen:hover { color: #fff; opacity: .9; }
        .invalid-feedback, .form-error-message { color: #ff8a73; display: block; }
        a { color: var(--zen-orange); }
        .muted { color: rgba(255,255,255,.55); }
        .badge-etat { background: rgba(255,86,48,.15); color: var(--zen-orange); border-radius: 20px; padding: 4px 12px; font-size: .8rem; font-weight: 600; }
        dl.fiche dt { color: rgba(255,255,255,.5); font-weight: 500; font-size: .85rem; }
        dl.fiche dd { color: #fff; margin-bottom: .7rem; }
        .piege { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    </style>
</head>
<body>
    <div class="espace-bar">
        <a class="brand" href="{{ path('espace_accueil') }}">ZenCAR<small>Espace pro</small></a>
        {% if app.user %}
            <div>
                <span class="muted small">{{ app.user.userIdentifier }}</span>
                <a class="nav-l" href="{{ path('espace_accueil') }}"><i class="bi bi-house"></i> Accueil</a>
                <a class="nav-l" href="{{ path('espace_ma_societe') }}"><i class="bi bi-building"></i> Ma société</a>
                <a class="nav-l" href="{{ path('espace_deconnexion') }}"><i class="bi bi-box-arrow-right"></i> Déconnexion</a>
            </div>
        {% endif %}
    </div>
    <div class="container px-3">
        {% for type, messages in app.flashes %}
            {% for m in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'info' }} mt-3 mx-auto" style="max-width:860px">{{ m }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</body>
</html>
