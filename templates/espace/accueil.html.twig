{% extends 'espace/base.html.twig' %}
{% block title %}Mon espace{% endblock %}
{% block body %}
<div class="zen-card zen-wide">
    <span class="badge-etat">{{ entreprise.etat.label }}</span>
    <h1 class="mt-3">Bonjour, {{ entreprise.nom }}</h1>
    <p class="mb-1">Abonnement : <strong>{{ entreprise.typeAbonnement ? entreprise.typeAbonnement.label : '—' }}</strong>
        {% if entreprise.typeAbonnement %}({{ entreprise.typeAbonnement.prixMensuelTtc }} € TTC / mois){% endif %}</p>
    {% if entreprise.etat.value == 'essai' and entreprise.essaiFin %}
        <p>Essai gratuit jusqu'au <strong>{{ entreprise.essaiFin|date('d/m/Y') }}</strong> inclus.</p>
    {% elseif entreprise.etat.value == 'lecture_seule' %}
        <p>Votre espace est en <strong>lecture seule</strong> : vous pouvez consulter vos documents, mais plus en créer. Contactez ZenCAR pour le réactiver.</p>
    {% endif %}
    <h2 class="h6 mt-4">Bientôt dans votre espace</h2>
    <ul class="muted">
        <li>Saisir et suivre vos courses</li>
        <li>Vos catégories de véhicules et vos prix</li>
        <li>Vos bons de commande et vos factures, à votre nom</li>
        {% if entreprise.typeAbonnement and entreprise.typeAbonnement.value == 'dispatcheur' %}<li>Partager vos courses (WhatsApp, Telegram, SMS)</li>{% endif %}
    </ul>
</div>
{% endblock %}
