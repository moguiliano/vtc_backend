{# Récapitulatif de la course — partagé entre le formulaire public (tab3) et la saisie admin par téléphone.
   Les ids recap_* sont remplis par Reservation.setRecap() (public/js/reservation.js) :
   une ligne dont la valeur est vide reste masquée (arrêt non coché, siège bébé non demandé…). #}
{% set rows = [
	{id: 'depart',         label: '📍 Départ',       strong: true},
	{id: 'stop',           label: '⏸ Arrêt'},
	{id: 'arrivee',        label: '🏁 Arrivée',      strong: true},
	{id: 'date',           label: '📅 Date & heure', strong: true},
	{id: 'distance',       label: '📏 Distance'},
	{id: 'duree',          label: '⏱ Durée'},
	{id: 'type',           label: '🚗 Véhicule',     strong: true},
	{id: 'siege',          label: '🧸 Siège bébé'},
	{id: 'prix_selected',  label: '💶 Prix estimé',  price: true},
] %}

<style>
	.zen-recap { width:100%; border-collapse:collapse; color:#ccc; font-size:.92rem; }
	.zen-recap tr:not([hidden]) ~ tr:not([hidden]) td { border-top:1px solid rgba(255,255,255,.06); }
	.zen-recap td { padding:9px 6px; }
	.zen-recap td:first-child { width:40%; color:rgba(255,255,255,.45); font-size:.8rem; text-transform:uppercase; letter-spacing:.5px; }
	.zen-recap .is-strong { color:white; font-weight:600; }
	.zen-recap .is-price { color:var(--zen-orange); font-weight:700; font-size:1.05rem; }
</style>

<h2 style="color:white;margin-bottom:1rem;">Récapitulatif de la course</h2>

<div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:18px 20px;margin-bottom:1.5rem;">
	<table class="zen-recap">
		{% for row in rows %}
			<tr id="recap_row_{{ row.id }}" hidden>
				<td>{{ row.label }}</td>
				<td class="{{ row.price is defined ? 'is-price' : (row.strong is defined ? 'is-strong') }}">
					<span id="recap_{{ row.id }}"></span>
				</td>
			</tr>
		{% endfor %}
	</table>
</div>
